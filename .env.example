# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------
NODE_ENV=development
HTTP_PORT=3000
INSTANCE_ID=api-local
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=wagering
POSTGRES_USER=wagering
POSTGRES_PASSWORD=wagering
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=20

# Convertem contenção patológica em erro transitório retentável,
# em vez de deixar a requisição pendurada.
DB_LOCK_TIMEOUT_MS=3000
DB_STATEMENT_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# SQS (MiniStack). Trocar por LocalStack exige mudar só AWS_ENDPOINT_URL.
# Credenciais locais são fake de propósito — não são segredo.
# ---------------------------------------------------------------------------
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

SQS_WAGER_TRANSACTIONS_QUEUE=wager-transactions.fifo
SQS_WAGER_TRANSACTIONS_DLQ=wager-transactions-dlq.fifo
SQS_WAGER_EVENTS_QUEUE=wager-events.fifo

SQS_MAX_RECEIVE_COUNT=5
SQS_WAIT_TIME_SECONDS=20
SQS_MAX_MESSAGES=10
SQS_VISIBILITY_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Workers
# ---------------------------------------------------------------------------
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_SECONDS=30
OUTBOX_MAX_ATTEMPTS=10

# Referências fora de ordem: backoff 2^n até o teto, 8 tentativas (~15 min).
PENDING_REFERENCE_POLL_INTERVAL_MS=5000
PENDING_REFERENCE_MAX_ATTEMPTS=8
PENDING_REFERENCE_BACKOFF_CAP_SECONDS=60

# Profundidade das filas: só alimenta gauge, não afeta processamento.
QUEUE_DEPTH_POLL_INTERVAL_MS=5000

SHUTDOWN_GRACE_PERIOD_MS=15000

# ---------------------------------------------------------------------------
# Domínio
# ---------------------------------------------------------------------------
DEFAULT_CURRENCY=BRL

# ---------------------------------------------------------------------------
# Portas expostas no host pelo docker-compose.yml
# Só mexa se alguma já estiver ocupada por outro projeto na sua máquina.
# `bun run verify:stack` lê estas mesmas variáveis.
# ---------------------------------------------------------------------------
# API_1_PORT=3000
# API_2_PORT=3001
# API_3_PORT=3002
# WORKER_1_PORT=3100
# WORKER_2_PORT=3101
# POSTGRES_HOST_PORT=5432
# MINISTACK_HOST_PORT=4566
# GRAFANA_PORT=3300
# PROMETHEUS_PORT=9090
