{
  "name": "distributed-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "description": "Distributed wagering transaction processor \u2014 Jungle Gaming technical challenge",
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev:api": "bun --watch src/main-api.ts",
    "dev:worker": "bun --watch src/main-worker.ts",
    "start:api": "bun src/main-api.ts",
    "start:worker": "bun src/main-worker.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "check": "biome check",
    "check:fix": "biome check --write",
    "test": "bun run test:unit && bun run test:integration && bun run test:concurrency",
    "test:unit": "bun test test/unit",
    "test:integration": "bun run infra:test:up && TEST_POSTGRES_PORT=55432 TEST_AWS_ENDPOINT_URL=http://localhost:54566 bun test test/integration --timeout 180000",
    "test:concurrency": "bun run infra:test:up && TEST_POSTGRES_PORT=55432 TEST_AWS_ENDPOINT_URL=http://localhost:54566 bun test test/concurrency --timeout 400000",
    "test:load": "bun scripts/run-load-test.ts",
    "infra:up": "docker compose up -d --wait --build --force-recreate",
    "infra:down": "docker compose down -v",
    "infra:observability:up": "docker compose --profile observability up -d --wait",
    "infra:observability:down": "docker compose --profile observability down",
    "infra:test:up": "docker compose -f docker-compose.test.yml up -d --wait && AWS_ENDPOINT_URL=http://localhost:54566 bun scripts/bootstrap-queues.ts && POSTGRES_PORT=55432 POSTGRES_DB=wagering_test bun scripts/mikro-orm-cli.ts migration:up",
    "infra:test:down": "docker compose -f docker-compose.test.yml down -v",
    "queues:bootstrap": "bun scripts/bootstrap-queues.ts",
    "queues:seed": "bun scripts/seed-queue.ts",
    "migration:create": "bun scripts/mikro-orm-cli.ts migration:create",
    "migration:up": "bun scripts/mikro-orm-cli.ts migration:up",
    "migration:down": "bun scripts/mikro-orm-cli.ts migration:down",
    "migration:verify": "POSTGRES_PORT=${POSTGRES_PORT:-55432} POSTGRES_DB=${POSTGRES_DB:-wagering_test} bun scripts/verify-migrations.ts",
    "verify:stack": "bun scripts/verify-stack.ts",
    "audit:business-rules": "bun scripts/business-rules-audit.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.699.0",
    "@mikro-orm/core": "^6.4.0",
    "@mikro-orm/migrations": "^6.4.0",
    "@mikro-orm/nestjs": "^6.0.2",
    "@mikro-orm/postgresql": "^6.4.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/terminus": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "decimal.js": "^10.4.3",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@mikro-orm/cli": "^6.4.0",
    "@types/bun": "^1.1.14",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
