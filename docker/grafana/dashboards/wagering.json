{
  "uid": "wagering-overview",
  "title": "Wagering — visão geral",
  "tags": ["wagering", "sqs", "outbox"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Fluxo SQS — entrada",
      "description": "Mensagens recebidas por segundo. Só sobe com carga publicada direto na fila: nenhuma rota HTTP escreve em wager-transactions.fifo. Use `bun run queues:seed`.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue) (rate(sqs_messages_received_total[1m]))",
          "legendFormat": "recebidas {{queue}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Fluxo SQS — saída",
      "description": "Deletadas após ack (consumo concluído) e publicadas pelo outbox publisher.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue) (rate(sqs_messages_deleted_total[1m]))",
          "legendFormat": "deletadas {{queue}}"
        },
        {
          "refId": "B",
          "expr": "sum by (queue) (rate(sqs_messages_sent_total[1m]))",
          "legendFormat": "publicadas {{queue}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Profundidade das filas",
      "description": "max, NÃO sum: os dois workers reportam a mesma série, somar dobraria o número. Valor aproximado por natureza no SQS.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (queue, state) (sqs_queue_depth)",
          "legendFormat": "{{queue}} · {{state}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "DLQ acumulada",
      "description": "Mensagens enviadas para a dead letter queue desde o boot.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue) (sqs_dlq_messages_total)",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Outbox — lag do evento mais antigo",
      "description": "Idade do evento não publicado mais antigo. Subindo sem parar = publisher não está dando conta.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [{ "refId": "A", "expr": "max(outbox_lag_seconds)", "legendFormat": "lag" }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Transações por kind e status",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind, status) (rate(wager_transactions_total[1m]))",
          "legendFormat": "{{kind}} · {{status}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Latência de processamento",
      "description": "Percentis do histograma wager_processing_duration_seconds.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 0, "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(wager_processing_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(wager_processing_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(wager_processing_duration_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Outbox — eventos pendentes",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "max(outbox_pending_total)", "legendFormat": "pendentes" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Duplicatas por origem",
      "description": "http, sqs, inbox, payload_conflict. Idempotência funcionando aparece aqui.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source) (rate(wager_duplicates_total[1m]))",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Retries por motivo",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(wager_retries_total[1m]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Conflitos de lock de wallet",
      "description": "lock_timeout, deadlock e serialization failure. É o custo da concorrência na mesma carteira.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation) (rate(wallet_lock_conflicts_total[1m]))",
          "legendFormat": "{{operation}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Ritmo de consumo (inbox)",
      "description": "Mensagens registradas no inbox por janela de 10s. O inbox guarda payload_hash, não o payload: mostra QUANDO consumiu, nunca O QUÊ.",
      "datasource": { "type": "postgres", "uid": "postgres" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(received_at, '10s'),\n  consumer_name AS metric,\n  count(*) AS value\nFROM inbox_messages\nWHERE $__timeFilter(received_at)\nGROUP BY 1, 2\nORDER BY 1"
        }
      ]
    },
    {
      "id": 13,
      "type": "table",
      "title": "Últimos eventos do outbox (com payload)",
      "description": "É aqui que se vê o CONTEÚDO do que saiu. LIMIT 50 sem filtro de tempo: outbox_messages só tem índice parcial em occurred_at (WHERE published_at IS NULL), então ordenar a tabela inteira não é servido por índice. Irrelevante no volume local.",
      "datasource": { "type": "postgres", "uid": "postgres" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 40 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  occurred_at   AS \"quando\",\n  event_type    AS \"evento\",\n  aggregate_id  AS \"wallet\",\n  attempts      AS \"tentativas\",\n  published_at  AS \"publicado\",\n  payload       AS \"payload\"\nFROM outbox_messages\nORDER BY occurred_at DESC\nLIMIT 50"
        }
      ]
    }
  ]
}
